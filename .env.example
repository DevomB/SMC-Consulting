# SMC public site does not need secrets in scaffold mode.
# Officers edit content/site.ts after LAUNCH_INPUTS.md gates pass.
# Do not put personal emails, Discord tokens, or private CRM values here.
#
# Public origin for canonical URLs, sitemap, and Open Graph in preview.
# Production builds use origin and basePath from content/site.ts instead.
# Include the repository subpath when using GitHub Pages without a custom domain.
# NEXT_PUBLIC_SITE_URL=
#
# Optional: only if a later approved form or analytics integration needs it.
# PUBLIC_FORM_ENDPOINT=
# PUBLIC_ANALYTICS_KEY=
# NEXT_PUBLIC_FORM_ENDPOINT=
# NEXT_PUBLIC_ANALYTICS_KEY=
# Analytics and cookies stay disabled until LAUNCH_INPUTS.md approves them.
